{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infradevops",
  "main": "dist/index.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "single-page-application"
  }
}
